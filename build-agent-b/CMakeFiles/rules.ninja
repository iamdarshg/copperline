  command = "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -S"C:\Users\Darsh Gupta\engineering-portfolio-audit\repos\copperline" -B"C:\Users\Darsh Gupta\engineering-portfolio-audit\repos\copperline\build-agent-b"
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = C:\Users\DARSHG~1\AppData\Roaming\Python\PYTHON~2\Scripts\ninja.exe $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = C:\Users\DARSHG~1\AppData\Roaming\Python\PYTHON~2\Scripts\ninja.exe -t targets
  description = All primary targets available:

